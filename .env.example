# ---------------------------------------------------------------
# Amfibia — пример файла окружения. Скопируйте в .env и заполните.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Длинная случайная строка для подписи cookie сессий
SESSION_SECRET=replace-with-long-random-string

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=amfibia

# --- Встроенный PostgreSQL (npm-пакет embedded-postgres) ---
# true  — если PostgreSQL в системе НЕ установлен: сервер сам поднимет локальный PostgreSQL
#         из node_modules, данные лягут в папку .pgdata (порт берётся из PGPORT, советуем 5433).
# false — если у вас свой PostgreSQL: укажите выше его хост, порт, пользователя и пароль.
USE_EMBEDDED_PG=false

# --- Прочее ---
BCRYPT_ROUNDS=12
UPLOAD_MAX_MB=5
