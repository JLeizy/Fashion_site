# ---------------------------------------------------------------
# Amfibia — пример файла окружения. Скопируйте в .env и заполните.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Длинная случайная строка для подписи cookie сессий
SESSION_SECRET=replace-with-long-random-string

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=amfibia

# --- Встроенный PostgreSQL (npm-пакет embedded-postgres) ---
# true  — (по умолчанию) PostgreSQL ставить не нужно: сервер сам поднимет локальный PostgreSQL
#         из node_modules, данные лягут в папку .pgdata (порт — PGPORT, по умолчанию 5433).
# false — если у вас свой PostgreSQL: укажите выше его хост, порт (обычно 5432), пользователя и пароль.
USE_EMBEDDED_PG=true

# --- Прочее ---
BCRYPT_ROUNDS=12
UPLOAD_MAX_MB=5
