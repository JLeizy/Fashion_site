{
  "name": "amfibia",
  "version": "1.0.0",
  "description": "Amfibia — маркетплейс брендовой одежды (Express + PostgreSQL + Vanilla JS)",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:embedded": "node db/embedded.js",
    "db:schema": "node db/init.js",
    "db:seed": "node db/seed.js",
    "placeholders": "node scripts/generate-placeholders.js",
    "setup": "npm run db:schema && npm run db:seed && npm run placeholders",
    "images": "node scripts/fetch-images.js",
    "images:collect": "node scripts/collect-image-sources.js",
    "images:fill": "node scripts/fill-missing-product-images.js"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/forum": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rubik-glitch": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.27",
    "multer": "^2.5.0",
    "ogl": "^1.0.11",
    "pg": "^8.23.1",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "sharp": "^0.35.5"
  }
}
